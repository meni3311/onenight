# ============================================================
# onenight backend — environment variables
# Copy to .env for local dev (gitignored). In production (Render), set
# these in the service's Environment settings instead of committing a file.
# ============================================================

# ---------- Server ----------
# Render sets this itself; only needed locally if you want a non-default port.
PORT=3000

# The deployed frontend's origin (Vercel), used to lock down CORS in
# main.ts. No trailing slash. Leave unset for local dev — the app falls
# back to allowing any origin (see main.ts).
FRONTEND_URL=https://your-app.vercel.app

# ---------- Database (Neon Postgres, via Prisma) ----------
# Neon dashboard → your project → Connect, with "Connection pooling" ON for
# the first and OFF for the second. They differ only by the `-pooler` in the
# host; both keep `?sslmode=require`.
#
# DATABASE_URL: pooled — used at runtime. Neon's pooler is PgBouncer in
#               transaction mode, so Prisma also needs `pgbouncer=true` to
#               stop it using prepared statements the pooler can't keep.
# DIRECT_URL:   unpooled — used only by `prisma migrate`, which needs a real
#               session (advisory locks, DDL) that a transaction pooler
#               cannot provide.
DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require

# ---------- Cloudflare R2 (listing photos) ----------
# R2 speaks the S3 API; the backend uses @aws-sdk/client-s3 against it.
# Account id: Cloudflare dashboard → R2 → Overview (also the hex string in
# the dashboard URL).
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Create token, "Object Read & Write" scoped to the
# bucket below. The secret is shown once, at creation.
# SECRET — server-only, never ship to the frontend.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dress-images
# Public read origin, no trailing slash. Either the bucket's r2.dev subdomain
# (Settings → Public Development URL) or a custom domain. This is what gets
# baked into every stored image URL, so changing it later means rewriting
# DressImage rows — pick the one you intend to keep.
R2_PUBLIC_BASE_URL=https://pub-[hash].r2.dev

# ---------- Admin panel ----------
# Shared password gating /#admin (see README) — no real auth yet.
ADMIN_PASSWORD=change-me-before-deploying

# ---------- Email OTP (registration / reset / account deletion) ----------
# resend.com API key. If unset, codes are logged to the server console
# instead of emailed — fine for local dev, not for production.
RESEND_API_KEY=
RESEND_FROM=onenight <onboarding@resend.dev>

# ---------- AI on-model photos (admin-only tool, fashn.ai) ----------
FASHN_API_KEY=
# Optional overrides — safe to leave unset, the service has defaults.
FASHN_MODEL_NAME=
FASHN_STUDIO_PROMPT=
