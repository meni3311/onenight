# ============================================================
# onenight backend — environment variables
# Copy to .env for local dev (gitignored). In production (Render), set
# these in the service's Environment settings instead of committing a file.
# ============================================================

# ---------- Server ----------
# Render sets this itself; only needed locally if you want a non-default port.
PORT=3000

# The deployed frontend's origin (Vercel). Two consumers:
#   1. CORS in main.ts. Leave unset for local dev — the app falls back to
#      allowing any origin (see main.ts).
#   2. The base of the "view your listing" link in the dress-approval email
#      (src/dresses/dress-status-mail.ts → <FRONTEND_URL>/#dress=<id>). That
#      link is opened from someone's inbox, so it has to be an absolute URL
#      that resolves from outside this machine — a localhost value here
#      produces an email whose button only works for you. Falls back to
#      http://localhost:5173 (the Vite dev server) when unset.
# No trailing slash.
FRONTEND_URL=https://your-app.vercel.app

# ---------- Database (Neon Postgres, via Prisma) ----------
# Neon dashboard → your project → Connect, with "Connection pooling" ON for
# the first and OFF for the second. They differ only by the `-pooler` in the
# host; both keep `?sslmode=require`.
#
# DATABASE_URL: pooled — used at runtime. Neon's pooler is PgBouncer in
#               transaction mode, so Prisma also needs `pgbouncer=true` to
#               stop it using prepared statements the pooler can't keep.
# DIRECT_URL:   unpooled — used only by `prisma migrate`, which needs a real
#               session (advisory locks, DDL) that a transaction pooler
#               cannot provide.
DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[db]?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[db]?sslmode=require

# ---------- Cloudflare R2 (listing photos) ----------
# R2 speaks the S3 API; the backend uses @aws-sdk/client-s3 against it.
# Account id: Cloudflare dashboard → R2 → Overview (also the hex string in
# the dashboard URL).
R2_ACCOUNT_ID=5f18998ba6e3830182f9327c41bd4599
# R2 → Manage API tokens → Create token, "Object Read & Write" scoped to the
# bucket below. The secret is shown once, at creation.
# SECRET — server-only, never ship to the frontend.
R2_ACCESS_KEY_ID=e5dceec7fc47a9040e5b123042a5e461
R2_SECRET_ACCESS_KEY=499a9311b8151e292f889aba4882ab8152b25ce13e9fcf892f2e8ab485a4e1e3
R2_BUCKET=onenight-bucket
# Public read origin, no trailing slash. Either the bucket's r2.dev subdomain
# (Settings → Public Development URL) or a custom domain. This is what gets
# baked into every stored image URL, so changing it later means rewriting
# DressImage rows — pick the one you intend to keep.
R2_PUBLIC_BASE_URL=https://pub-7565beea7b9f4f4788f6e228f554f8f7.r2.dev

# ---------- Admin panel ----------
# Shared password gating /#admin (see README) — no real auth yet.
ADMIN_PASSWORD=change-me-before-deploying

# ---------- Email (Resend) ----------
# Used by BOTH the login/registration OTP (src/auth-otp/otp.service.ts) and
# the dress approval/rejection notifications sent to a lister when an admin
# moderates their listing (src/common/mail.service.ts).
#
# resend.com API key. If unset: OTP codes fall back to being logged to the
# server console, and moderation emails are not sent at all — MailService logs
# a "NOT SENT" line naming this variable, and the admin panel's toast reports
# the failure rather than claiming an email was sent.
RESEND_API_KEY=
# The From header. THE DOMAIN HERE MUST BE VERIFIED IN THE RESEND DASHBOARD —
# an unverified sending domain is the most common cause of a 403 from Resend
# once the key itself is correct, and MailService names that possibility in
# its error log. onboarding@resend.dev works without verification but can only
# deliver to the address that owns the Resend account.
RESEND_FROM=onenight <onboarding@resend.dev>

# ---------- AI on-model photos (admin-only tool, fashn.ai) ----------
FASHN_API_KEY=
# Optional overrides — safe to leave unset, the service has defaults.
FASHN_MODEL_NAME=
FASHN_STUDIO_PROMPT=
