// Prisma schema for the onenight dress-rental marketplace.
// Database: Supabase (PostgreSQL).
//   DATABASE_URL  — pooled connection (PgBouncer, port 6543) used at runtime
//   DIRECT_URL    — direct connection (port 5432) used for migrations
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DressCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  FAIR
}

enum DressSource {
  PERSONAL_TAILOR
  BOUTIQUE
  STORE
}

enum DressLength {
  SHORT
  MEDIUM
  LONG
}

enum SleeveLength {
  SHORT
  MEDIUM
  LONG
}

// Mirrors the (now-retired) TypeORM `users` entity field-for-field, so the
// SQLite → Postgres move is a pure persistence swap with no behaviour change.
// NOTE: `id` is app-generated (uuid) rather than mirroring auth.users.id from
// Supabase Auth — the rows migrated out of SQLite already carry their own
// uuids, and login is email+password via bcrypt, not Supabase Auth.
model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  // Deliberately nullable and NOT unique: it's a display-only handle derived
  // from the email local-part (see UsersService.deriveUsername), never used
  // for login or lookup. One migrated row already has NULL here, and derived
  // handles can legitimately collide across different email domains.
  username String?
  city     String?
  password String // bcrypt hash, stored as-is — never re-hashed
  verified Boolean @default(false)
  // Opt-out consent: the registration checkbox is checked by default, and the
  // service falls back to `true` when a client omits the field.
  marketingConsent Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dresses          Dress[]
  bookingsMade     Booking[]        @relation("renter")
  bookingsReceived Booking[]        @relation("lister")
  reviewsWritten   Review[]         @relation("reviewer")
  favorites        Favorite[]
  bookingInquiries BookingInquiry[] @relation("bookingInquiries")
}

model Dress {
  id          String         @id @default(uuid())
  name        String
  description String?
  price       Float
  fabric      String?
  color       String?
  designer    String?
  source      DressSource
  condition   DressCondition
  // `dressLength`/`sleeveLength` are the structured length filter fields
  // (short/medium/long each). The old free-form `length` column that used to
  // duplicate `dressLength` has been removed — `dressLength` is now the
  // single source of truth for a dress's length.
  dressLength  DressLength
  sleeveLength SleeveLength
  // Free-text city, distinct from `User.city`. Nullable/optional so existing
  // listings created before this field don't break.
  city         String?
  ownerId      String
  owner        User                @relation(fields: [ownerId], references: [id])
  status       String              @default("pending") // pending | approved | rejected
  sizes        DressSize[]
  images       DressImage[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]
  availability DressAvailability[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([color])
  @@index([source])
  @@index([ownerId])
  @@index([dressLength])
  @@index([sleeveLength])
}

model DressSize {
  id        String  @id @default(uuid())
  dress     Dress   @relation(fields: [dressId], references: [id], onDelete: Cascade)
  dressId   String
  size      String // XS, S, M, L, XL, XXL
  available Boolean @default(true)

  @@index([dressId])
}

model DressImage {
  id      String @id @default(uuid())
  dress   Dress  @relation(fields: [dressId], references: [id], onDelete: Cascade)
  dressId String
  url     String
  order   Int

  @@index([dressId])
}

// Owner-managed per-day override for a dress's availability. Absence of a
// row for a given (dressId, date) means available — owners only need to
// write a row for the days they want to block out, not populate the whole
// calendar. Not yet read by any renter-facing flow (out of scope for now);
// this is scoped to the owner's own management UI.
model DressAvailability {
  id      String   @id @default(uuid())
  dress   Dress    @relation(fields: [dressId], references: [id], onDelete: Cascade)
  dressId String
  date    DateTime
  status  String   @default("unavailable") // available | unavailable

  @@unique([dressId, date])
  @@index([dressId])
}

model Booking {
  id        String   @id @default(uuid())
  dress     Dress    @relation(fields: [dressId], references: [id], onDelete: Cascade)
  dressId   String
  startDate DateTime
  endDate   DateTime
  size      String
  createdAt DateTime @default(now())

  renterId    String
  renter      User      @relation("renter", fields: [renterId], references: [id])
  listerId    String
  lister      User      @relation("lister", fields: [listerId], references: [id])
  status      String    @default("pending") // pending | confirmed | declined | expired
  requestedAt DateTime  @default(now())
  respondsBy  DateTime // application code sets this = requestedAt + 24h
  respondedAt DateTime?
  // Back-relation for Review.booking's one-to-one @unique bookingId.
  review      Review?

  @@index([dressId])
  @@index([startDate, endDate])
  @@index([renterId])
  @@index([listerId])
}

model Review {
  id       String @id @default(uuid())
  dress    Dress  @relation(fields: [dressId], references: [id], onDelete: Cascade)
  dressId  String
  reviewer String
  rating   Int // 1–5
  text     String
  sizeWorn String
  createdAt DateTime @default(now())

  // NOTE: the brief asked for these new fields to include a relation field
  // literally named `reviewer`, but this model already has an (unrelated,
  // free-text) `reviewer String` column — keeping both under the same name
  // isn't possible. Since the brief also said not to rename/delete any
  // existing column, the old `reviewer` string is left untouched and the
  // new user relation is named `reviewerUser` instead. Flag if you'd
  // rather retire the free-text field in favor of the relation.
  reviewerId   String
  reviewerUser User     @relation("reviewer", fields: [reviewerId], references: [id])
  revieweeId   String
  bookingId    String   @unique // one review per completed booking
  booking      Booking  @relation(fields: [bookingId], references: [id])

  @@index([dressId])
  @@index([reviewerId])
}

// Logs every click of the dress-detail page's "להזמנה" button (the WhatsApp
// contact CTA — see ProductPage.jsx's book()), so admin can follow up and
// check whether a deal closed. Deliberately NOT the same table as `Booking`
// above: `Booking` is older, unrelated, currently-dormant infrastructure for
// a full renter/lister request-response workflow (status, 24h SLA) — not a
// payment schema (checked: no payment/stripe/checkout code or mentions
// anywhere in this repo's history) — and this feature explicitly has no
// status/workflow beyond "exists, can be deleted." Keeping them separate
// avoids overloading Booking's semantics with this simpler logging use case.
//
// `renterId` is a genuine relation — this button already requires the
// renter to be logged in, so there's always a real User row. `dressId` /
// `dressTitle` / `ownerPhone` are a denormalized snapshot instead of
// relations, because dresses (and their owners' listing-contact info)
// currently live only in the frontend's localStorage mock, not in this
// database — see the note on Dress's lack of a `phone` field. There is no
// real Dress row for a foreign key to point at.
model BookingInquiry {
  id          String @id @default(uuid())

  renterId    String
  renter      User   @relation("bookingInquiries", fields: [renterId], references: [id])
  renterPhone String // snapshot at click-time, independent of later profile edits

  dressId     String // the mock system's dress id — app already routes to dress detail by this id
  dressTitle  String
  ownerPhone  String

  selectedStartDate DateTime
  selectedEndDate   DateTime

  createdAt   DateTime @default(now())

  @@index([renterId])
  @@index([dressId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dressId   String
  dress     Dress    @relation(fields: [dressId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dressId])
  @@index([userId])
  @@index([dressId])
}
