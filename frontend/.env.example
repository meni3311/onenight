# ============================================================
# onenight frontend — environment variables
# Copy to .env for local dev (git-ignored). In production (Vercel), set
# these in the project's Environment Variables settings instead.
# ============================================================

# ---------- Backend API origin ----------
# The deployed NestJS backend's URL (Render), no trailing slash. Read by
# lib/api.js's withBase() and used for every API call in the app.
#
# Leave unset for local dev: Vite's dev server proxies /api straight to
# http://localhost:3000 (see vite.config.js), so requests stay same-origin
# and no base URL is needed.
VITE_API_BASE_URL=https://your-backend.onrender.com

# ---------- Supabase (currently unused) ----------
# Project Settings → API → Project URL / Project API keys → anon public.
# Read by lib/supabaseClient.ts, which nothing in the app imports right
# now — the live dress/auth flow goes entirely through the backend above.
# Left here since it's already in this project's .env; safe to drop both
# if that file is ever removed.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
